erDiagram
    CLIENTE ||--o{ VENDA : realiza
    FUNCIONARIO ||--o{ VENDA : atende
    VENDA ||--|{ ITEM_VENDA : contem
    VEICULO ||--o| ITEM_VENDA : "e vendido em"
    VENDA ||--o| FINANCIAMENTO : possui
    VENDA ||--o{ PAGAMENTO : "e quitada por"
    FORNECEDOR ||--o{ PECA : fornece
    FORNECEDOR |o--o{ VEICULO : fornece
    PECA ||--|| ESTOQUE_PECA : "tem saldo em"
